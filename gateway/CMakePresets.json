{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "win-base",
      "hidden": true,
      "generator": "Ninja",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    },
    {
      "name": "win",
      "inherits": "win-base",
      "displayName": "Windows Release (MSVC + Ninja + vcpkg) — benchmarks",
      "binaryDir": "${sourceDir}/build/win",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "win-debug",
      "inherits": "win-base",
      "displayName": "Windows Debug — checked STL iterators",
      "binaryDir": "${sourceDir}/build/win-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "win-asan",
      "inherits": "win-base",
      "displayName": "Windows AddressSanitizer",
      "binaryDir": "${sourceDir}/build/win-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "FMDG_ASAN": "ON"
      }
    },
    {
      "name": "linux",
      "displayName": "Linux (GCC/Clang + Ninja + vcpkg)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/linux",
      "toolchainFile": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win",
      "configurePreset": "win"
    },
    {
      "name": "win-debug",
      "configurePreset": "win-debug"
    },
    {
      "name": "win-asan",
      "configurePreset": "win-asan"
    },
    {
      "name": "linux",
      "configurePreset": "linux"
    }
  ],
  "testPresets": [
    {
      "name": "win",
      "configurePreset": "win",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-debug",
      "configurePreset": "win-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "win-asan",
      "configurePreset": "win-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "linux",
      "configurePreset": "linux",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
